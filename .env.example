# 配置模板（占位值）。复制为 .env.test 后填入真实信息，应用只读取 .env.test。
#   copy .env.example .env.test

# ---------- 数据库 ----------
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/gd_job_radar

# Docker Compose 用（仅 docker compose 时）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=gd_job_radar
POSTGRES_PORT=5432

# ---------- 采集 ----------
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0 Safari/537.36
COLLECTOR_RATE_LIMIT_SECONDS=1.5
COLLECTOR_SOURCES=gz_rsj
DATA_DIR=./data
CRAWL_TARGET_YEAR=2026
TARGET_CITIES=广州,东莞,佛山

# ---------- 调度 ----------
SCHEDULER_TIMEZONE=Asia/Shanghai
MORNING_DIGEST_HOUR=8
MORNING_DIGEST_MINUTE=0
EVENING_DIGEST_HOUR=18
EVENING_DIGEST_MINUTE=0
RUN_JOB_ON_START=false

# ---------- 邮件（QQ SMTP 授权码） ----------
# QQ：465+SSL 或 587+STARTTLS；部分网络 465 会报 WRONG_VERSION_NUMBER，请用下面 587 配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_qq@qq.com
MAIL_RECIPIENTS=your_qq@qq.com

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 个人画像（岗位邮件筛选） ----------
PROFILE_AGE=25
PROFILE_EDUCATION=本科
PROFILE_MAJOR=信息管理与信息系统
PROFILE_CANDIDATE_STATUS=社会人员
PROFILE_IS_FRESH_GRADUATE=false

PROFILE_MAJOR_ALIASES=信息管理,管理科学与工程,计算机,电子信息,软件工程
PROFILE_MAJOR_RELATED_KEYWORDS=计算机,软件,网络,数据,信息,管理,电子商务,统计
PROFILE_ENABLE_RELAXED_MAJOR=true

PROFILE_FRESH_EXCLUDE_KEYWORDS=仅限应届,限应届,仅应届,应届毕业生报考,限应届毕业生
PROFILE_SOCIAL_EXCLUDE_KEYWORDS=仅限应届毕业生,仅面向应届
PROFILE_FRESH_INCLUDE_KEYWORDS=应届,应届毕业生,应往届

PROFILE_JOB_INCLUDE_KEYWORDS=
PROFILE_JOB_EXCLUDE_KEYWORDS=
